services:
  mysql-backend:
    image: mysql:latest
    volumes:
      - mysql-backend:/var/lib/mysql
    restart: always
    environment:
      MYSQL_ROOT_PASSWORD: password
      MYSQL_DATABASE: db_name
      MYSQL_USER: username
      MYSQL_PASSWORD: user_password
      MYSQL_TCP_PORT: 3307
    ports:
      - '3307:3307'
    expose:
      - 3307
    healthcheck:
      test: mysqladmin ping -h 127.0.0.1 -u $$MYSQL_USER --password=$$MYSQL_PASSWORD
    networks:
      - network_name

  backend-flask:
    build:
      context: ./backend
      dockerfile: Dockerfile
    container_name: backend-flask
    command: gunicorn --bind 0.0.0.0:8000 --workers 2 'main:create_app()' --reload
    volumes:
      - ./backend:/webapp
    depends_on:
      mysql-backend:
        condition: service_healthy
    ports:
      - "8000:8000"
    networks:
      - network-name

  frontend-react:
    build:
      context: ./frontend
      dockerfile: Dockerfile
    container_name: frontend-react
    volumes:
      - ./frontend:/app
      - /app/node_modules
    ports:
      - "5173:5173"
    command: npm run dev -- --host
    networks:
      - network-name

  frontend-nginx:
    image: nginx:latest
    volumes:
      - ./frontend/default.conf:/etc/nginx/conf.d/default.conf
    ports:
      - '80:80'
    depends_on:
      - frontend-react
      - backend-flask
    networks:
      - network-name

volumes:
  mysql-backend:

networks:
  network-name: